---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { categories, subcategories } from '../i18n/ui';

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: { depth: number; slug: string; text: string }[];
	body?: string;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	category,
	sub,
	lang = 'zh',
	headings = [],
	body = '',
} = Astro.props;

const catLabel = category ? categories[category]?.[lang] : undefined;
const subLabel =
	category && sub ? (subcategories as any)[category]?.[sub]?.[lang] : undefined;

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

// 阅读时长：中文按字数、英文按词数粗估
const cjk = (body.match(/[一-鿿]/g) || []).length;
const words = (body.replace(/[一-鿿]/g, ' ').match(/[A-Za-z0-9]+/g) || []).length;
const minutes = Math.max(1, Math.round((cjk + words * 1.5) / 400));
const readLabel = lang === 'en' ? `${minutes} min read` : `约 ${minutes} 分钟`;
const tocLabel = lang === 'en' ? 'Contents' : '目录';
const updatedLabel = lang === 'en' ? 'Updated' : '更新于';

const hasMermaid = body.includes('class="mermaid"');
---

<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<div id="progress"></div>
		<Header />
		<div class="wrap">
			{
				toc.length > 1 && (
					<nav class="toc" aria-label={tocLabel}>
						<div class="toc-t">{tocLabel}</div>
						{toc.map((h) => (
							<a href={`#${h.slug}`} class:list={['toc-link', { sub: h.depth === 3 }]}>
								{h.text}
							</a>
						))}
					</nav>
				)
			}
			<main class:list={[{ 'no-toc': toc.length <= 1 }]}>
				<article class="prose">
					<header class="post-head">
						{
							catLabel && (
								<div class="crumb">
									<span>{catLabel}</span>
									{subLabel && <span class="sep">·</span>}
									{subLabel && <span>{subLabel}</span>}
								</div>
							)
						}
						<h1>{title}</h1>
						{description && <p class="desc">{description}</p>}
						<div class="pills">
							<span class="pill"><FormattedDate date={pubDate} /></span>
							<span class="pill">{readLabel}</span>
							{
								updatedDate && (
									<span class="pill">
										{updatedLabel} <FormattedDate date={updatedDate} />
									</span>
								)
							}
						</div>
					</header>
					<slot />
				</article>
			</main>
		</div>
		<Footer />

		{
			hasMermaid && (
				<script
					type="module"
					is:inline
					set:html={`
					import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
					function renderMermaid(){
						var nodes = document.querySelectorAll('.mermaid');
						nodes.forEach(function(el){
							if(el.dataset.src == null){ el.dataset.src = el.textContent; }
							else { el.textContent = el.dataset.src; }
							el.removeAttribute('data-processed');
						});
						var dark = document.documentElement.getAttribute('data-theme') === 'dark';
						mermaid.initialize({ startOnLoad:false, theme: dark?'dark':'neutral', securityLevel:'loose', fontFamily:'inherit' });
						try { mermaid.run({ querySelector: '.mermaid' }); } catch(e){}
					}
					renderMermaid();
					var tb = document.getElementById('themeToggle');
					if(tb) tb.addEventListener('click', function(){ setTimeout(renderMermaid, 60); });
				`}
				/>
			)
		}

		<script is:inline>
			(function () {
				var bar = document.getElementById('progress');
				function onScroll() {
					var h = document.documentElement.scrollHeight - window.innerHeight;
					bar.style.width = (h > 0 ? (window.scrollY / h) * 100 : 0) + '%';
				}
				window.addEventListener('scroll', onScroll, { passive: true });
				onScroll();

				var links = [].slice.call(document.querySelectorAll('.toc-link'));
				if (links.length) {
					var map = {};
					links.forEach(function (a) {
						var id = a.getAttribute('href').slice(1);
						var el = document.getElementById(id);
						if (el) map[id] = a;
					});
					var io = new IntersectionObserver(
						function (entries) {
							entries.forEach(function (e) {
								if (e.isIntersecting) {
									links.forEach(function (l) { l.classList.remove('on'); });
									var a = map[e.target.id];
									if (a) a.classList.add('on');
								}
							});
						},
						{ rootMargin: '-12% 0px -75% 0px' }
					);
					Object.keys(map).forEach(function (id) {
						io.observe(document.getElementById(id));
					});
				}
			})();
		</script>

		<style>
			#progress {
				position: fixed;
				top: 0;
				left: 0;
				height: 3px;
				width: 0;
				background: linear-gradient(90deg, var(--accent), var(--amber));
				z-index: 100;
			}
			.wrap {
				max-width: 1160px;
				margin: 0 auto;
				padding: 0 24px;
				display: grid;
				grid-template-columns: 220px minmax(0, 1fr);
				gap: 56px;
				align-items: start;
			}
			nav.toc {
				position: sticky;
				top: 24px;
				padding: 40px 0;
				font-size: 13.5px;
				max-height: calc(100vh - 48px);
				overflow-y: auto;
			}
			.toc-t {
				font-size: 11px;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--muted);
				margin-bottom: 12px;
			}
			.toc-link {
				display: block;
				color: var(--muted);
				text-decoration: none;
				padding: 5px 12px;
				border-left: 2px solid var(--line);
				line-height: 1.5;
			}
			.toc-link.sub {
				padding-left: 22px;
				font-size: 12.5px;
			}
			.toc-link:hover {
				color: var(--ink);
			}
			.toc-link.on {
				color: var(--accent);
				border-left-color: var(--accent);
				font-weight: 600;
				background: var(--accent-soft);
				border-radius: 0 8px 8px 0;
			}
			main {
				padding: 40px 0 120px;
				min-width: 0;
			}
			.prose {
				max-width: 720px;
			}
			main.no-toc .prose {
				margin: 0 auto;
			}
			.post-head {
				margin-bottom: 2.4em;
			}
			.crumb {
				display: inline-flex;
				align-items: center;
				gap: 0.5em;
				font-size: 0.8rem;
				letter-spacing: 0.05em;
				color: var(--amber);
				font-weight: 700;
				margin-bottom: 0.6em;
			}
			.crumb .sep {
				opacity: 0.5;
			}
			.post-head h1 {
				margin: 0 0 0.35em;
			}
			.desc {
				color: var(--muted);
				font-size: 1.05rem;
				margin: 0 0 1em;
			}
			.pills {
				display: flex;
				gap: 8px;
				flex-wrap: wrap;
			}
			.pill {
				background: var(--surface);
				border: 1px solid var(--line);
				border-radius: 999px;
				padding: 4px 12px;
				font-size: 12.5px;
				color: var(--muted);
				box-shadow: var(--shadow);
			}
			@media (max-width: 900px) {
				.wrap {
					grid-template-columns: 1fr;
					gap: 0;
				}
				nav.toc {
					display: none;
				}
				main {
					padding: 24px 0 80px;
				}
			}
		</style>
	</body>
</html>
