---
import type {CollectionEntry} from 'astro:content';
import Site from './Site.astro';
import Icon from '../components/Icon.astro';
import {categories,modules} from '../i18n/ui';
import {copy} from '../i18n/design';
import {calendarDate,prefix,minutes} from '../lib/posts';
type Props=CollectionEntry<'blog'>['data'] & {headings?:{depth:number;slug:string;text:string}[];body?:string};
const {title,description,pubDate,updatedDate,heroImage,category,module:moduleKey,submodule,lang='zh',headings=[],body=''}=Astro.props;
const d=copy(lang),pre=prefix(lang),toc=headings.filter(h=>h.depth===2||h.depth===3);
const mod=modules[category].find(m=>m.key===moduleKey);
const hasMermaid=body.includes('class="mermaid"');
---
<Site title={`${title} | ${d.title}`} description={description} image={heroImage}>
<div class="reading-progress" aria-hidden="true"></div>
<div class="article-shell"><a class="back-link" href={`${pre}/blog/`}>← {d.back}</a>
<header class="article-heading"><span class="article-category"><a href={`${pre}/blog/${category}/`}>{categories[category][lang]}</a>{mod&&` · ${mod.label[lang]}`}</span><h1>{title}</h1><p class="article-description">{description}</p><div class="article-meta"><span class="author-dot">T</span><span>Tim</span><time datetime={pubDate.toISOString()}>{calendarDate(pubDate).replaceAll('-','.')}</time><span>{minutes(body)} {d.minute}</span>{updatedDate&&<span>{d.updated} <time datetime={updatedDate.toISOString()}>{calendarDate(updatedDate)}</time></span>}</div></header>
<div class:list={['article-layout',{'no-toc':!toc.length}]}>{!!toc.length&&<aside class="article-toc"><p>{d.contents}</p><nav aria-label={d.contents}>{toc.map(h=><a class:list={[{sub:h.depth===3}]} href={`#${h.slug}`}>{h.text}</a>)}</nav></aside>}<article class="prose"><slot/></article></div>
<div class="article-end"><span aria-hidden="true">✳</span><h2>{d.end}</h2><a class="button button-outline" href={`${pre}/blog/`}>{d.explore}<Icon name="arrow"/></a></div>
</div>
<Fragment slot="scripts">
		{
			hasMermaid && (
				<script
					type="module"
					is:inline
					set:html={`
					import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
					function renderMermaid(){
						var nodes = document.querySelectorAll('.mermaid');
						nodes.forEach(function(el){
							if(el.dataset.src == null){ el.dataset.src = el.textContent; }
							else { el.textContent = el.dataset.src; }
							el.removeAttribute('data-processed');
						});
						var dark = document.documentElement.getAttribute('data-theme') === 'dark';
						mermaid.initialize({ startOnLoad:false, theme: dark?'dark':'neutral', securityLevel:'loose', fontFamily:'inherit' });
						try { mermaid.run({ querySelector: '.mermaid' }); } catch(e){}
					}
					renderMermaid();
					var tb = document.getElementById('themeToggle');
					if(tb) tb.addEventListener('click', function(){ setTimeout(renderMermaid, 60); });
				`}
				/>
			)
		}

</Fragment></Site>
