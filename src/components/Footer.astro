---
import {getLangFromUrl} from '../i18n/ui';
import {copy} from '../i18n/design';
import {prefix} from '../lib/posts';
import Icon from './Icon.astro';
const lang=getLangFromUrl(Astro.url),d=copy(lang),pre=prefix(lang);
---
<footer class="site-footer section-shell"><a class="footer-wordmark" href={`${pre}/`}><Icon/>{d.title}</a><p>{d.footer}</p><div><a href="https://github.com/tim-1992/tims-notes" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href={`${pre}/rss.xml`}>RSS ↗</a><span>© {new Date().getFullYear()} Tim</span></div></footer>
