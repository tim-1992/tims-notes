---
import { modules } from '../i18n/ui';
import FormattedDate from './FormattedDate.astro';

const { posts, category, lang, prefix } = Astro.props;

const RN = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'];
const emptyLabel = lang === 'en' ? 'Coming soon' : '待补充';

const mods = modules[category] ?? [];
const modKeys = mods.map((m) => m.key);

const mblocks = mods.map((m, i) => {
	const modPosts = posts.filter((p) => p.data.module === m.key);
	const subKeys = m.subs.map((s) => s.key);
	let subBlocks = m.subs.map((s) => ({
		label: s.label[lang],
		posts: modPosts.filter((p) => p.data.submodule === s.key),
	}));
	const looseInMod = modPosts.filter((p) => !p.data.submodule || !subKeys.includes(p.data.submodule));
	if (looseInMod.length) subBlocks = [{ label: null, posts: looseInMod }, ...subBlocks];
	return { key: m.key, num: RN[i] ?? String(i + 1), label: m.label[lang], desc: m.desc[lang], count: modPosts.length, subBlocks };
});

const orphan = posts.filter((p) => !p.data.module || !modKeys.includes(p.data.module));
const orphanBlock = orphan.length
	? [{ key: null, num: null, label: null, desc: '', count: orphan.length, subBlocks: [{ label: null, posts: orphan }] }]
	: [];
const blocks = [...orphanBlock, ...mblocks];
---

<div class="modtree">
	{
		blocks.map((m) => (
			<div class="module">
				{m.label && (
					<div class="mod-head">
						<h3 class="mod-title">
							{m.num && <span class="mod-num">{m.num}</span>}
							{m.label}
							<span class="count">{m.count}</span>
						</h3>
						{m.desc && <p class="mod-desc">{m.desc}</p>}
					</div>
				)}
				{m.subBlocks.map((b) => (
					<div class="block">
						{b.label && <h4 class="sub-title">{b.label}</h4>}
						{b.posts.length > 0 ? (
							<ol class="index">
								{b.posts.map((post, i) => (
									<li>
										<span class="idx">{String(i + 1).padStart(2, '0')}</span>
										<a class="post-title" href={`${prefix}/blog/${post.id}/`}>
											{post.data.title}
										</a>
										<span class="date">
											<FormattedDate date={post.data.pubDate} />
										</span>
									</li>
								))}
							</ol>
						) : (
							<p class="empty">{emptyLabel}</p>
						)}
					</div>
				))}
			</div>
		))
	}
</div>

<style>
	.module {
		margin-bottom: 2rem;
	}
	.mod-head {
		margin: 1.6rem 0 0.6rem;
	}
	.mod-title {
		display: flex;
		align-items: baseline;
		gap: 0.5em;
		font-size: 1.25rem;
		margin: 0;
		color: var(--ink);
	}
	.mod-num {
		color: var(--accent);
		font-weight: 800;
		font-size: 1.5rem;
		line-height: 1;
	}
	.mod-num::after {
		content: '、';
	}
	:global([lang='en']) .mod-num::after {
		content: '.';
	}
	.mod-desc {
		margin: 0.2em 0 0 0.9em;
		color: var(--muted);
		font-size: 0.9rem;
	}
	.sub-title {
		font-size: 1.18rem;
		font-weight: 700;
		color: var(--ink2);
		margin: 1rem 0 0.3rem 0;
	}
	.sub-title::before {
		content: '▸ ';
		color: var(--accent);
	}
	.block {
		margin-left: 0.9em;
	}
	.count {
		font-size: 0.8rem;
		font-weight: 400;
		color: var(--muted);
	}
	ol.index {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	ol.index li {
		display: flex;
		align-items: baseline;
		gap: 0.75em;
		padding: 0.5em 0;
		border-bottom: 1px dashed var(--line);
	}
	ol.index .idx {
		flex: none;
		width: 1.6em;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}
	ol.index .post-title {
		flex: 1;
		color: var(--ink);
		text-decoration: none;
		font-size: 1.05rem;
	}
	ol.index .post-title:hover {
		color: var(--accent);
	}
	ol.index .date {
		flex: none;
		color: var(--muted);
		font-size: 0.85rem;
		white-space: nowrap;
	}
	.empty {
		margin: 0.2em 0 0;
		padding-left: 0.2em;
		color: var(--muted);
		font-size: 0.9rem;
		font-style: italic;
	}
	@media (max-width: 560px) {
		ol.index li {
			flex-wrap: wrap;
			gap: 0.2em 0.6em;
		}
		ol.index .date {
			width: 100%;
			padding-left: 2.35em;
		}
	}
</style>
