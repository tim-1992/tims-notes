---
import {getLangFromUrl} from '../i18n/ui';
import {copy} from '../i18n/design';
import {prefix,postsFor,languageLink} from '../lib/posts';
import Icon from './Icon.astro';
const lang=getLangFromUrl(Astro.url),d=copy(lang),pre=prefix(lang),home=`${pre}/`;
const posts=await postsFor(lang),other=await languageLink(Astro.url);
const path=Astro.url.pathname;
---
<a href="#main-content" class="skip-link">{d.skip}</a>
<header class="site-header">
 <a class="wordmark" href={home} aria-label={`${d.title} — ${d.home}`}><Icon class="brand-icon"/><span>{d.title}<span class="wordmark-small">A LITTLE OUT OF THE BOX.</span></span></a>
 <nav aria-label={lang==='en'?'Main navigation':'主导航'}>
  <a class:list={['nav-home',{active:path===home}]} href={home} aria-current={path===home?'page':undefined}>{d.home}</a>
  <a class:list={['nav-archive',{active:path.includes('/blog')}]} href={`${pre}/blog/`} aria-current={path.includes('/blog')?'page':undefined}>{d.notes}<span class="nav-count">{posts.length}</span></a>
  <a class:list={['nav-about',{active:path.includes('/about')}]} href={`${pre}/about/`} aria-current={path.includes('/about')?'page':undefined}>{d.about}</a>
 </nav>
 <div class="header-actions">
  <button class="search-trigger icon-button js-only" aria-label={d.search} title={`${d.search} (/)`}><Icon name="search"/><kbd>/</kbd></button>
  <button class="motion-toggle icon-button js-only" aria-label={d.pause} data-pause={d.pause} data-resume={d.resume} aria-pressed="false"><span class="motion-bars" aria-hidden="true"><i></i><i></i><i></i></span></button>
  <a class="lang-link" href={other.href} lang={other.lang} aria-label={other.lang==='en'?'Switch to English':'切换到中文'} title={!other.exact?(lang==='zh'?'暂无对应译文，查看英文同主题文章':'No translation yet; browse this topic in Chinese'):undefined}>{other.lang==='en'?'EN':'中文'} <span>↗</span></a>
 </div>
</header>
