---
import {getLangFromUrl} from '../i18n/ui';
interface Props {date:Date}
const {date}=Astro.props;
const lang=getLangFromUrl(Astro.url);
---
<time datetime={date.toISOString()}>{date.toLocaleDateString(lang==='en'?'en-US':'zh-CN',{year:'numeric',month:'short',day:'numeric',timeZone:'Asia/Shanghai'})}</time>
