---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { categories, categoryOrder, getLangFromUrl, useTranslations } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const prefix = lang === 'en' ? '/en' : '';

const recent = (await getCollection('blog', ({ data }) => data.lang === lang))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
const cats = categoryOrder.map((k) => ({ key: k, label: categories[k][lang] }));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={t('site.title')} description={t('site.description')} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="glow" aria-hidden="true"></div>
				<p class="wave">👋</p>
				<h1>{t('home.heading')}</h1>
				<p class="lede">{t('home.intro')}</p>
				<div class="actions">
					<a class="btn btn-primary" href={`${prefix}/blog`}>{t('home.cta')}</a>
					<a class="btn btn-ghost" href={`${prefix}/about`}>{t('home.about_cta')}</a>
				</div>
			</section>

			<section class="browse">
				<h2>{t('home.browse')}</h2>
				<div class="chips">
					{cats.map((c) => <a class="chip" href={`${prefix}/blog#${c.key}`}>{c.label}</a>)}
				</div>
			</section>

			<section class="recent">
				<h2>{t('home.recent')}</h2>
				<ul>
					{
						recent.map((post) => (
							<li>
								<a href={`${prefix}/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image class="thumb" width={480} height={240} src={post.data.heroImage} alt="" />
									)}
									<span class="tag">{categories[post.data.category][lang]}</span>
									<h3 class="title">{post.data.title}</h3>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 960px;
		max-width: calc(100% - 2em);
	}

	/* Hero */
	.hero {
		position: relative;
		text-align: center;
		padding: 2.5rem 1rem 3.5rem;
		margin-bottom: 2rem;
		overflow: hidden;
	}
	.glow {
		position: absolute;
		top: -120px;
		left: 50%;
		transform: translateX(-50%);
		width: 620px;
		max-width: 100%;
		height: 360px;
		background: radial-gradient(
			closest-side,
			rgba(37, 99, 235, 0.32),
			rgba(8, 145, 178, 0.22) 55%,
			transparent 80%
		);
		filter: blur(20px);
		z-index: -1;
	}
	.wave {
		font-size: 3rem;
		margin: 0;
		animation: wave 2.5s ease-in-out infinite;
		transform-origin: 70% 70%;
		display: inline-block;
	}
	@keyframes wave {
		0%, 60%, 100% { transform: rotate(0deg); }
		10% { transform: rotate(14deg); }
		20% { transform: rotate(-8deg); }
		30% { transform: rotate(14deg); }
		40% { transform: rotate(-4deg); }
		50% { transform: rotate(10deg); }
	}
	@media (prefers-reduced-motion: reduce) {
		.wave { animation: none; }
	}
	.hero h1 {
		font-size: clamp(2.4rem, 6vw, 3.4rem);
		margin: 0.2em 0 0.3em;
		background: linear-gradient(120deg, #2563eb, #0891b2 55%, #10b981);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
	.lede {
		max-width: 640px;
		margin: 0 auto 1.8rem;
		color: rgb(var(--gray-dark));
		font-size: 1.15rem;
	}
	.actions {
		display: flex;
		gap: 0.8rem;
		justify-content: center;
		flex-wrap: wrap;
	}
	.btn {
		display: inline-block;
		padding: 0.65em 1.4em;
		border-radius: 999px;
		text-decoration: none;
		font-weight: 700;
		transition: transform 0.15s ease, box-shadow 0.2s ease;
	}
	.btn:hover {
		transform: translateY(-2px);
	}
	.btn-primary {
		color: #fff;
		background: linear-gradient(120deg, #2563eb, #0891b2);
		box-shadow: 0 6px 20px rgba(8, 145, 178, 0.35);
	}
	.btn-ghost {
		color: rgb(var(--gray-dark));
		border: 1px solid rgb(var(--gray-light));
		background: rgba(255, 255, 255, 0.6);
	}
	.btn-ghost:hover {
		border-color: #0891b2;
		color: #0891b2;
	}

	/* Browse chips */
	.browse {
		margin-bottom: 3rem;
	}
	.browse h2,
	.recent h2 {
		font-size: 1.6rem;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}
	.chip {
		padding: 0.4em 1em;
		border-radius: 999px;
		text-decoration: none;
		font-size: 0.95rem;
		color: rgb(var(--gray-dark));
		background: rgb(var(--gray-light));
		transition: all 0.15s ease;
	}
	.chip:hover {
		color: #fff;
		background: linear-gradient(120deg, #2563eb, #0891b2);
	}

	/* Recent cards */
	.recent ul {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
		list-style: none;
		padding: 0;
		margin: 1rem 0 0;
	}
	.recent li a {
		display: block;
		text-decoration: none;
		color: inherit;
	}
	.thumb {
		width: 100%;
		height: auto;
		border-radius: 14px;
		margin-bottom: 0.6rem;
		box-shadow: 0 4px 14px rgba(var(--gray), 25%);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
	.recent li a:hover .thumb {
		transform: translateY(-3px);
		box-shadow: var(--box-shadow);
	}
	.tag {
		display: inline-block;
		font-size: 0.75rem;
		color: #0891b2;
		font-weight: 700;
		margin-bottom: 0.2rem;
	}
	.recent .title {
		font-size: 1.15rem;
		margin: 0 0 0.2rem;
		line-height: 1.3;
	}
	.recent li a:hover .title {
		color: #2563eb;
	}
	.recent .date {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.9rem;
	}
	@media (max-width: 720px) {
		.recent ul {
			grid-template-columns: 1fr;
		}
	}
</style>
