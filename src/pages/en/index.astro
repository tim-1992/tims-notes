---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { categories, categoryOrder, getLangFromUrl, useTranslations } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const prefix = lang === 'en' ? '/en' : '';

const recent = (await getCollection('blog', ({ data }) => data.lang === lang))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
const cats = categoryOrder.map((k) => ({ key: k, label: categories[k][lang] }));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={t('site.title')} description={t('site.description')} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="glow" aria-hidden="true"></div>
				<p class="wave">👋</p>
				<h1>{t('home.heading')}</h1>
				<p class="lede">{t('home.intro')}</p>
				<div class="actions">
					<a class="btn btn-primary" href={`${prefix}/blog`}>{t('home.cta')}</a>
					<a class="btn btn-ghost" href={`${prefix}/about`}>{t('home.about_cta')}</a>
				</div>
			</section>

			<section class="browse">
				<h2>{t('home.browse')}</h2>
				<div class="chips">
					{cats.map((c) => <a class="chip" href={`${prefix}/blog/${c.key}/`}>{c.label}</a>)}
				</div>
			</section>

			<section class="recent">
				<h2>{t('home.recent')}</h2>
				<ul>
					{
						recent.map((post) => (
							<li>
								<a href={`${prefix}/blog/${post.id}/`}>
									<span class="tag">{categories[post.data.category][lang]}</span>
									<h3 class="title">{post.data.title}</h3>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 960px;
		max-width: calc(100% - 2em);
	}
	.hero {
		position: relative;
		text-align: center;
		padding: 2.5rem 1rem 3.5rem;
		margin-bottom: 2rem;
		overflow: hidden;
	}
	.glow {
		position: absolute;
		top: -120px;
		left: 50%;
		transform: translateX(-50%);
		width: 620px;
		max-width: 100%;
		height: 360px;
		background: radial-gradient(
			closest-side,
			rgba(106, 77, 212, 0.22),
			rgba(201, 114, 42, 0.12) 55%,
			transparent 80%
		);
		filter: blur(20px);
		z-index: -1;
	}
	.wave {
		font-size: 3rem;
		margin: 0;
		animation: wave 2.5s ease-in-out infinite;
		transform-origin: 70% 70%;
		display: inline-block;
	}
	@keyframes wave {
		0%, 60%, 100% { transform: rotate(0deg); }
		10% { transform: rotate(14deg); }
		20% { transform: rotate(-8deg); }
		30% { transform: rotate(14deg); }
		40% { transform: rotate(-4deg); }
		50% { transform: rotate(10deg); }
	}
	@media (prefers-reduced-motion: reduce) {
		.wave { animation: none; }
	}
	.hero h1 {
		font-size: clamp(2.4rem, 6vw, 3.4rem);
		margin: 0.2em 0 0.3em;
		background: linear-gradient(120deg, var(--accent), var(--amber));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
	.lede {
		max-width: 640px;
		margin: 0 auto 1.8rem;
		color: var(--ink2);
		font-size: 1.12rem;
	}
	.actions {
		display: flex;
		gap: 0.8rem;
		justify-content: center;
		flex-wrap: wrap;
	}
	.btn {
		display: inline-block;
		padding: 0.65em 1.4em;
		border-radius: 999px;
		text-decoration: none;
		font-weight: 700;
		transition: transform 0.15s ease, box-shadow 0.2s ease;
	}
	.btn:hover {
		transform: translateY(-2px);
	}
	.btn-primary {
		color: #fff;
		background: var(--accent);
		box-shadow: 0 6px 18px rgba(106, 77, 212, 0.32);
	}
	.btn-ghost {
		color: var(--ink2);
		border: 1px solid var(--line);
		background: var(--surface);
	}
	.btn-ghost:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.browse {
		margin-bottom: 3rem;
	}
	.browse h2,
	.recent h2 {
		font-size: 1.5rem;
		border: none;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}
	.chip {
		padding: 0.4em 1em;
		border-radius: 999px;
		text-decoration: none;
		font-size: 0.95rem;
		color: var(--accent);
		background: var(--surface);
		border: 1px solid var(--line);
		transition: all 0.15s ease;
	}
	.chip:hover {
		color: #fff;
		background: var(--accent);
		border-color: var(--accent);
	}
	.recent ul {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.2rem;
		list-style: none;
		padding: 0;
		margin: 1rem 0 0;
	}
	.recent li a {
		display: block;
		text-decoration: none;
		color: inherit;
		height: 100%;
		box-sizing: border-box;
		padding: 1.2rem 1.3rem;
		background: var(--surface);
		border: 1px solid var(--line);
		border-top: 3px solid var(--accent);
		border-radius: 3px 3px 12px 12px;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
	.recent li a:hover {
		transform: translateY(-3px);
		box-shadow: var(--shadow);
	}
	.tag {
		display: inline-block;
		font-size: 0.75rem;
		color: var(--amber);
		font-weight: 700;
		letter-spacing: 0.05em;
		margin-bottom: 0.3rem;
	}
	.recent .title {
		font-size: 1.12rem;
		margin: 0 0 0.4rem;
		line-height: 1.4;
		color: var(--ink);
	}
	.recent li a:hover .title {
		color: var(--accent);
	}
	.recent .date {
		margin: 0;
		color: var(--muted);
		font-size: 0.88rem;
	}
	@media (max-width: 720px) {
		.recent ul {
			grid-template-columns: 1fr;
		}
	}
</style>
