---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import { categories, categoryOrder, getLangFromUrl, modules, useTranslations } from '../../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const prefix = lang === 'en' ? '/en' : '';

const all = await getCollection('blog', ({ data }) => data.lang === lang);

const cards = categoryOrder.map((key) => ({
	key,
	label: categories[key][lang],
	count: all.filter((p) => p.data.category === key).length,
	mods: (modules[key] ?? []).map((m) => m.label[lang]),
}));
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={`${t('blog.title')} | ${t('site.title')}`} description={t('site.description')} />
		<style>
			main {
				width: 820px;
				max-width: calc(100% - 2em);
			}
			.page-title {
				margin-bottom: 1.5rem;
			}
			.cards {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.2rem;
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.cards li a {
				display: block;
				height: 100%;
				box-sizing: border-box;
				padding: 1.3rem 1.4rem;
				text-decoration: none;
				color: inherit;
				background: var(--surface);
				border: 1px solid var(--line);
				border-top: 3px solid var(--accent);
				border-radius: 3px 3px 12px 12px;
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}
			.cards li a:hover {
				transform: translateY(-3px);
				box-shadow: var(--shadow);
			}
			.card-head {
				display: flex;
				align-items: baseline;
				gap: 0.5em;
				margin-bottom: 0.5rem;
			}
			.card-title {
				font-size: 1.35rem;
				margin: 0;
				color: var(--ink);
			}
			.cards li a:hover .card-title {
				color: var(--accent);
			}
			.count {
				font-size: 0.8rem;
				color: var(--muted);
			}
			.mods {
				margin: 0;
				color: var(--ink2);
				font-size: 0.9rem;
				line-height: 1.6;
			}
			@media (max-width: 600px) {
				.cards {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1 class="page-title">{t('blog.title')}</h1>
			<ul class="cards">
				{
					cards.map((c) => (
						<li>
							<a href={`${prefix}/blog/${c.key}/`}>
								<div class="card-head">
									<h2 class="card-title">{c.label}</h2>
									<span class="count">{c.count}</span>
								</div>
								<p class="mods">{c.mods.join(' · ')}</p>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
